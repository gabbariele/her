# Copia questo file in `.env` e incolla le tue chiavi dopo il segno `=`.
# Niente virgolette, niente spazi: CHIAVE=valore

# Quale configurazione usare (sono i file dentro la cartella `presets`).
#   gemini       tutto su Gemini: la più economica, serve solo GEMINI_API_KEY
#   intervista   ospite generico su OpenAI
#   veloce       risposte cortissime, latenza minima (OpenAI)
HER_PRESET=gemini

# --- La voce dell'ospite: serve sempre --------------------------------------
# La chiave la prendi su https://elevenlabs.io -> profilo -> API Keys
ELEVENLABS_API_KEY=
# L'id della voce scelta: doppio clic su voci.bat
HER_VOICE_ID=

# Quanti secondi di silenzio aspettare prima che l'ospite risponda.
# Alzalo se fai pause per pensare mentre parli.
HER_PAUSA=1.4

# --- Il carattere dell'ospite, regolabile senza aprire i preset -------------
# Quanto parla:  breve | media | lunga | monologo
HER_LUNGHEZZA=lunga
# Quanto ti rimanda la palla:  mai | raramente | spesso
HER_DOMANDE=raramente
# Indicazione libera, scritta come la diresti a un ospite vero:
HER_INDICAZIONI=

# --- Se usi il preset `gemini` (consigliato: costa meno) --------------------
# La chiave la prendi su https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Se usi i preset su OpenAI (intervista, veloce, esperto-tech) -----------
# La chiave la prendi su https://platform.openai.com/api-keys
OPENAI_API_KEY=
