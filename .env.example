# Copia questo file in `.env` e incolla le tue chiavi dopo il segno `=`.
# Niente virgolette, niente spazi: CHIAVE=valore

# Serve per capire quello che dici (trascrizione) e per le risposte dell'ospite.
# La prendi su https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Serve per la voce dell'ospite.
# La prendi su https://elevenlabs.io -> il tuo profilo -> API Keys
ELEVENLABS_API_KEY=

# La voce scelta: prendi l'id con `her voices` (o doppio clic su voci.command).
HER_VOICE_ID=

# Facoltativo: alternativa a OpenAI per trascrizione e/o risposte.
# La prendi su https://aistudio.google.com/apikey
GEMINI_API_KEY=
